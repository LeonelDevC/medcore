# Configuración del API Go. Copiar a `.env` o exportar en la shell.
APP_ENV=development
API_ADDR=:8080

# Origen permitido por CORS (el dev server de Vite).
API_ALLOWED_ORIGIN=http://localhost:5173

# Tokens de desarrollo "token:rol" separados por coma.
# Sustituto temporal de JWT: sin API_TOKENS, /api responde 401.
API_TOKENS=dev-admin-token:admin,dev-medico-token:medico

# Vacío = repositorio en memoria (MVP). Un DSN exige driver Postgres,
# que todavía no está incluido (ver pkg/database).
DATABASE_URL=
